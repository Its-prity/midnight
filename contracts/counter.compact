// ============================================================================
// MIDNIGHT COMPACT SMART CONTRACT — PRIVACY-PRESERVING COUNTER
// ============================================================================
// PRIVACY MODEL:
// 1. PUBLIC LEDGER STATE (On-Chain, Visible to Anyone):
//    - `counter`: A Cell containing a Uint<32> storing the current on-chain count.
//
// 2. PRIVATE WITNESS / INPUT (Off-Chain, Never Stored On-Chain):
//    - `secret_increment`: Private input value provided off-chain by caller.
//
// 3. ZERO-KNOWLEDGE PROOF / DISCLOSE:
//    - `disclose(secret_increment)`: Explicitly discloses the secret increment
//      amount to update the public counter state while proving circuit logic
//      (e.g., secret_increment > 0) without revealing any other private context.
// ============================================================================

pragma language_version >= 0.14.0;

import CompactStandardLibrary;

export ledger counter: Cell<Uint<32>>;

export circuit increment(secret_increment: Uint<32>): [] {
    // Enforce private circuit logic constraint
    assert secret_increment > 0 "Increment amount must be greater than zero";

    // Explicitly disclose the private witness input to update public ledger state
    const inc = disclose(secret_increment);
    counter.write(counter.read() + inc);
}

export circuit reset(): [] {
    counter.write(0);
}
